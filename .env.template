# Web Search Plus — API Keys Template
# Reference list of the variables Web Search Plus reads. Since 5.1 the plugin
# does not read .env files itself: store keys in your Hermes profile with
# `hermes config set NAME <key>` or in Hermes Desktop. For the standalone
# search.py, export them first (set -a; . ~/.hermes/.env; set +a).
# No single key is required. Add at least one search provider for
# web_search_plus and one extraction provider for web_extract_plus;
# more keys = better auto-routing coverage.

# Serper (Google Search) — https://serper.dev — 2,500 free/month
SERPER_API_KEY=***

# Brave Search — https://brave.com/search/api/ — $5.00/mo in free credits; you won't be charged
BRAVE_API_KEY=***

# Tavily (Research/Analysis) — https://tavily.com — 1,000 free/month
TAVILY_API_KEY=

# Exa (Neural/Semantic Search) — https://exa.ai — 1,000 free/month
EXA_API_KEY=

# Querit (Multilingual AI Search) — https://querit.ai — 1,000 free/month
QUERIT_API_KEY=

# Linkup (Source-grounded AI search) — https://linkup.so — €5 free credits monthly
LINKUP_API_KEY=***

# Firecrawl search
FIRECRAWL_API_KEY=***

# You.com — https://api.you.com
# YOU_API_KEY=

# Keenable (independent web index) — https://keenable.ai
# KEENABLE_API_KEY=
# Optional: opt into the keyless public endpoint (off by default — sends queries
# and fetched URLs to an unauthenticated service, ~1000 req/hour & 10 req/sec
# per-IP limits, no SLA). Or set keenable.allow_public in config.json.
# KEENABLE_ALLOW_PUBLIC=1

# SearXNG (self-hosted, no API key needed — just set your instance URL)
# SEARXNG_INSTANCE_URL=https://your-searxng-instance.example.com

# Optional Jev (TypeSafe System One) — off by default. Never put the key in config.json.
# TYPESAFE_API_KEY=

# DonSeTch 2.3.1 (local stdio MCP; explicit-only)
# DONSETCH_BIN=/absolute/path/to/donsetch
